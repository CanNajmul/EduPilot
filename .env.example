# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GROQ_API_KEY=

# LangSmith tracing (optional but required for course C2 evidence)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=edupilot

# Optional overrides
PRIMARY_MODEL=gemini-2.5-flash
FALLBACK_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# For Bangla or mixed-language material use: BAAI/bge-m3
SIMILARITY_THRESHOLD=0.35
